# Runtime environment (local/prod).
env=local
version=0.1.0
log_level=INFO

# Database / cache.
DATABASE_URL=postgresql+asyncpg://roxase:roxase@localhost:5433/roxase
REDIS_URL=redis://localhost:6380/0

# Auth. Override in production via a secrets manager (never hardcode real keys).
jwt_secret_key=change-me-in-production-use-openssl-rand-hex-32
jwt_algorithm=HS256
jwt_access_token_expire_minutes=15
jwt_refresh_token_expire_days=7

# Outreach safety. dry_run is STICKY; keep True unless a real send is explicitly
# enabled for a channel. outreach_enabled=False is a global kill switch.
DRY_RUN=true
outreach_enabled=true

# Outbox worker.
worker_enabled=true
worker_poll_interval=1.0
worker_batch_size=50
worker_lease_seconds=60
worker_max_attempts=5
worker_base_backoff=2.0
worker_max_backoff=600.0