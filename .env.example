# Runtime environment (local/prod).
env=local
version=0.1.0
log_level=INFO
log_json=false

# Database / cache (docker-compose in prod uses the postgres/redis service names).
DATABASE_URL=postgresql+asyncpg://roxase:roxase@localhost:5433/roxase
TEST_DATABASE_URL=postgresql+asyncpg://roxase:roxase@localhost:5433/roxase_test
REDIS_URL=redis://localhost:6380/0

# DB connection pool.
db_pool_size=10
db_max_overflow=20
db_pool_timeout=30

# Auth. Override in production via a secrets manager (never hardcode real keys).
jwt_secret_key=change-me-in-production-use-openssl-rand-hex-32
jwt_algorithm=HS256
jwt_access_token_expire_minutes=15
jwt_refresh_token_expire_days=7

# Outreach safety. dry_run is STICKY; keep True unless a real send is explicitly
# enabled for a channel. outreach_enabled=False is a global kill switch.
DRY_RUN=true
outreach_enabled=true

# Outbox worker.
worker_enabled=true
worker_poll_interval=1.0
worker_batch_size=50
worker_lease_seconds=60
worker_max_attempts=5
worker_base_backoff=2.0
worker_max_backoff=600.0

# Real email provider (SMTP). Leave smtp_host unset to keep using
# MockEmailProvider (the default for local/dev/test — nothing is really
# sent). Setting DRY_RUN=false in production without smtp_host configured
# is refused at boot by validate_production().
smtp_host=
smtp_port=587
smtp_username=
smtp_password=
smtp_from_email=
smtp_from_name=
smtp_use_tls=true
smtp_timeout_seconds=10

# Rate limiting (auth + outreach create). Keep enabled in production.
rate_limit_enabled=true
rate_limit_rps=100
rate_limit_burst=200
rate_limit_window=5

# CORS. "*" is fine for local dev only (auth is Bearer-token, not cookie,
# so a wildcard origin can't exfiltrate ambient credentials) — production
# MUST set an explicit comma-separated allowlist, enforced by
# validate_production().
cors_allowed_origins=*